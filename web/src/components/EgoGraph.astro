---
// "Connected in the lessons": the entry in the middle, its strongest connections on both sides.
// The names are ordinary HTML boxes that grow to fit their text (long names wrap instead of spilling out);
// only the connecting lines are SVG, stretched behind them. Built at page-build time — no JavaScript needed.
// On a phone the same connections are shown as a simple list.
import { TYPE_NAMES, type Entity } from "../lib/data.ts";
interface Props { center: Entity; links: [Entity, number][] }
const { center, links } = Astro.props;
const items = links.slice(0, 10);
const max = Math.max(1, ...items.map(([, c]) => c));
// strongest first, alternating sides, so both sides carry strong links
const left = items.filter((_, i) => i % 2 === 0);
const right = items.filter((_, i) => i % 2 === 1);
const rows = Math.max(left.length, right.length, 1);
const y = (i: number, n: number) => ((i + 0.5 + (rows - n) / 2) / rows) * 100;
const width = (c: number) => (1.5 + (5 * c) / max).toFixed(1);
const kind = (e: Entity) => TYPE_NAMES[e.type]?.[0] ?? "Topic";
const together = (c: number) => `together on ${c} slide${c === 1 ? "" : "s"}`;
const lang = (e: Entity) => (e.type === "word" && (e.lang === "he" || e.lang === "el") ? e.lang : undefined);
---
{items.length > 1 && (
  <figure class="ego2" aria-label={`What is connected to ${center.label}`}>
    <div class="ego2-stage" style={`--rows:${rows}`}>
      <svg class="ego2-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {left.map(([, c], i) => <line x1="50" y1="50" x2="35" y2={y(i, left.length)} stroke-width={width(c)} />)}
        {right.map(([, c], i) => <line x1="50" y1="50" x2="65" y2={y(i, right.length)} stroke-width={width(c)} />)}
      </svg>
      {left.map(([e, c], i) => (
        <a class="ego2-node ego2-l" href={e.url} title={`${e.label} — ${together(c)}`} style={`grid-row:${1 + 2 * i + rows - left.length} / span 2`}>
          <span class="ego2-label" lang={lang(e)} dir="auto">{e.label}</span>
          <span class="ego2-meta">{kind(e)} · {c} slide{c === 1 ? "" : "s"}</span>
        </a>
      ))}
      <div class="ego2-center">
        <span class="ego2-meta">{kind(center)}</span>
        <strong class="ego2-label" lang={lang(center)} dir="auto">{center.label}</strong>
      </div>
      {right.map(([e, c], i) => (
        <a class="ego2-node ego2-r" href={e.url} title={`${e.label} — ${together(c)}`} style={`grid-row:${1 + 2 * i + rows - right.length} / span 2`}>
          <span class="ego2-label" lang={lang(e)} dir="auto">{e.label}</span>
          <span class="ego2-meta">{kind(e)} · {c} slide{c === 1 ? "" : "s"}</span>
        </a>
      ))}
    </div>
    <figcaption class="muted small">Thicker lines mean they appear together on more slides. Tap a name to explore it.</figcaption>
  </figure>
)}
{items.length > 1 && (
  <ol class="ego2-list" aria-label={`What is connected to ${center.label}`}>
    {items.map(([e, c]) => (
      <li><a href={e.url}>
        <span class="ego2-bar" style={`width:${Math.round(18 + (82 * c) / max)}%`} aria-hidden="true"></span>
        <span class="ego2-label" lang={lang(e)} dir="auto">{e.label}</span>
        <span class="ego2-meta">{kind(e)} · {together(c)}</span>
      </a></li>
    ))}
  </ol>
)}
