---
import Base from "../../layouts/Base.astro";
import { ENTITIES } from "../../lib/data.ts";
const words = ENTITIES.filter((e) => e.type === "word").map((e) => {
  const tr = e.translit.slice().sort((a, b) => a.length - b.length)[0] ?? "";
  return { e, tr, sortKey: (tr || e.gloss[0] || e.label).toLowerCase() };
}).sort((a, b) => a.sortKey.localeCompare(b.sortKey));
const he = words.filter((w) => w.e.lang !== "el");
const el = words.filter((w) => w.e.lang === "el");
---
<Base title="Hebrew & Greek Words" nav="words" crumbs={[{ label: "Hebrew & Greek Words" }]}>
  <h1>Hebrew &amp; Greek Words</h1>
  <p class="lead">Every Hebrew and Greek word the lessons explain, with its meaning. Choose a word to see every slide that teaches it.</p>
  <label for="wf" class="visually-hidden">Filter words</label>
  <input class="filter-input" id="wf" type="search" placeholder="Type to filter — English meaning, sound, or Hebrew/Greek letters" data-filter="#wordlists li" />
  {[["Hebrew", he], ["Greek", el]].map(([title, list]) => (list as typeof he).length > 0 && (
    <section class="section" id={`${(title as string).toLowerCase()}-words`}>
      <h2>{title} words <span class="muted small">({(list as typeof he).length})</span></h2>
      <ul class="list" id="wordlists">
        {(list as typeof he).map(({ e, tr }) => (
          <li data-text={[e.label, tr, ...e.gloss, ...e.forms, e.strongs ?? ""].join(" ").toLowerCase()}>
            <a class="row" href={e.url}>
              <span><strong lang={e.lang === "el" ? "el" : "he"} style="font-size:1.3em">{e.label}</strong> {tr && <span class="translit">{tr}</span>}<br /><span>{e.gloss.slice(0, 3).join("; ")}</span></span>
              <span class="muted">{e.slides.length} slide{e.slides.length === 1 ? "" : "s"}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <script>
    import "../../scripts/filter.ts";
  </script>
</Base>
