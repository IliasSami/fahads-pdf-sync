{
  // Static site served by Cloudflare Workers Static Assets (free: unlimited requests to static files).
  // No server code runs: search happens in the visitor's browser.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slides",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
