  },
  {
   "lang": "en",
   "role": "list",
   "text": "Do not engage in illicit sexual relations."
  },
  {
   "lang": "en",
   "role": "list",
   "text": "Do not steal."
  },
  {
   "lang": "en",
   "role": "list",
   "text": "Do not eat from a live animal."
  },
  {
   "lang": "en",
   "role": "list",
   "text": "Establish courts/legal system to ensure obedience to laws."
  }
