 "title": "The three are so likeminded they are as one",
 "summary": "The four trust statements about Isaac, Abraham and the most trusted servant remain, with a new closing line: the three are so likeminded that they are as one.",
 "text": [
  {
   "lang": "en",
   "role": "body",
   "text": "Isaac trusts his father"
  },
  {
   "lang": "en",
   "role": "body",
   "text": "by allowing himself to be tied up to be sacrificed."
  },
  {
   "lang": "en",
   "role": "body",
   "text": "Abraham trusts his servant, Eliezer"
  },
  {
   "lang": "en",
   "role": "body",
   "text": "so much he was his sole heir."
  },
  {
   "lang": "en",
   "role": "body",
   "text": "Isaac trusts Abraham and most trusted servant"
  },
  {
   "lang": "en",
   "role": "body",
   "text": "to find a bride for him."
  },
  {
   "lang": "en",
   "role": "body",
   "text": "The most trusted servant"
  },
  {
   "lang": "en",
   "role": "body",
   "text": "remaining nameless, points to Isaac, the Son."
  },
  {
   "lang": "en",
   "role": "heading",
   "text": "The three are so likeminded; they are as one."
  }
 ],
